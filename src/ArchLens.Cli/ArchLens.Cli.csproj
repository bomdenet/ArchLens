<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ArchLens.Model\ArchLens.Model.csproj" />
    <ProjectReference Include="..\ArchLens.Analysis\ArchLens.Analysis.csproj" />
    <ProjectReference Include="..\ArchLens.Rules.Yaml\ArchLens.Rules.Yaml.csproj" />
    <ProjectReference Include="..\ArchLens.Query\ArchLens.Query.csproj" />
    <ProjectReference Include="..\ArchLens.Extraction.Roslyn\ArchLens.Extraction.Roslyn.csproj" />
    <ProjectReference Include="..\ArchLens.Extraction.Metadata\ArchLens.Extraction.Metadata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>archlens</ToolCommandName>
    <PackageId>ArchLens.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>ArchLens CLI - Agent-friendly C# architecture analyzer for local checks and CI/CD.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
